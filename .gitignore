# Publish only the curated files; local research inputs/outputs stay untracked.
*
!/.gitignore
!/README.md
!/requirements.txt
!/REFERENCES.bib
!/THIRD_PARTY_NOTICES.md
!/config/
/config/*
!/config/paths.json
!/code/
/code/*
!/code/*.py
!/docs/
/docs/*
!/docs/*.md
!/docs/*.json
!/figures/
/figures/*
!/figures/*.png
!/download/
/download/*
!/download/README.md
!/download/singapore_building_population.geojson
!/download/singapore_building_population.geojson.gz
!/download/building_population_attributes.csv
!/download/subzone_population_controls.csv
!/download/metadata.json
!/download/SHA256SUMS.txt
!/data/
/data/*
!/data/raw/
/data/raw/*
!/data/raw/population/
/data/raw/population/*
!/data/raw/population/manifest.json
